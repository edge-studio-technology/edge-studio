HOST_FILES_DIR=/home/pi
FRONTEND_PORT=8080
# Backend container timezone — set to the Pi's real local timezone (e.g. Europe/Amsterdam) so
# the nightly Minima auto-backup (00:30) lands at actual local night instead of UTC.
TZ=UTC
DATA_DIR=./data
# Native dev: paths above/below are relative to the repo root when running npm run dev:backend
DATABASE_PATH=./data/edge-studio.db
MINIMA_STATUS_URL=http://127.0.0.1:9005/status
PORT=3000
APP_SECRET=dev-change-me
# Set COOKIE_SECURE=true for Docker HTTPS deploy; false for native npm run dev (HTTP :5173)
COOKIE_SECURE=false
SESSION_MAX_AGE_DAYS=7
SESSION_IDLE_HOURS=24
DOCKER_GID=0
# Advanced install shortcut: set ENABLE_GPIO=true to have install.sh create a Docker Compose override that mounts /dev/gpiochip0 for GPIO input sources.
ENABLE_GPIO=false
GPIO_GID=0
# Advanced install shortcut: set ENABLE_CAMERA=true to have install.sh enable the host camera helper during install. Normal installs can enable camera later from Devices -> Hardware support.
ENABLE_CAMERA=false
CAMERA_CAPTURE_DIR=/data/captures
CAMERA_HELPER_URL=http://host.docker.internal:38180
CAMERA_HELPER_TOKEN=
CAMERA_HELPER_PORT=38180
CAMERA_MAX_DURATION_SECONDS=30
CAMERA_RETENTION_DAYS=7
CAMERA_PHOTO_COMMAND=rpicam-still
CAMERA_VIDEO_COMMAND=rpicam-vid
# Advanced install shortcut: set ENABLE_SENSORS=true to install a host-side I2C sensor helper for BME280/BME680 environmental sensor reads.
ENABLE_SENSORS=false
SENSOR_HELPER_URL=http://host.docker.internal:38181
SENSOR_HELPER_TOKEN=
SENSOR_HELPER_PORT=38181
SENSOR_READ_TIMEOUT_MS=5000
# Advanced install shortcut: set ENABLE_MQTT_BROKER=true and COMPOSE_PROFILES=mqtt to run the optional local Mosquitto broker.
ENABLE_MQTT_BROKER=false
COMPOSE_PROFILES=
MQTT_PUBLIC_HOST=
MQTT_PUBLIC_PORT=1883
MQTT_INTERNAL_URL=mqtt://mqtt:1883
# Host-agent is installed by install.sh and lets the app request narrow, allowlisted host hardware setup actions.
HOST_AGENT_URL=http://host.docker.internal:38182
HOST_AGENT_TOKEN=
HOST_AGENT_PORT=38182
MINIMA_DATA_DIR=./minima
MINIMA_P2P_PORT=9003
MINIMA_RPC_BIND=127.0.0.1
MINIMA_RPC_PORT=9005
MINIMA_HEALTH_POLL_INTERVAL_SECONDS=60
MINIMA_STALL_BLOCK_AGE_SECONDS=300
MINIMA_AUTO_RESYNC=false
MINIMA_AUTO_RESYNC_COOLDOWN_MINUTES=30
INTEGRITAS_CONNECT_BASE_URL=https://integritas.technology
INTEGRITAS_BASE_URL=https://integritas.technology/core
INTEGRITAS_REQUEST_ID=edge-studio
INTEGRITAS_REQUEST_TIMEOUT_MS=15000
INTEGRITAS_POLL_INTERVAL_SECONDS=30
INTEGRITAS_PROOF_POLL_TIMEOUT_MINUTES=5
INTEGRITAS_DEVICE_POLL_INTERVAL_SECONDS=5
# External portal link shown in Integritas config modal (defaults to profile API logs tab)
INTEGRITAS_PORTAL_URL=
# URL of the signed update manifest, served from edgestudio.technology by default.
# update-agent falls back to the public edge-studio-manifests GitHub repo (raw.githubusercontent.com) if this fetch fails.
# install.sh also reads this to fetch the exact frontend/backend image digests for a fresh install.
MANIFEST_URL=
# Frontend/backend/update-agent image refs (ghcr.io digest), resolved by install.sh from the manifest at install time.
# Not meant to be set by hand.
FRONTEND_IMAGE=
BACKEND_IMAGE=
UPDATE_AGENT_IMAGE=
RELEASE_CHANNEL=stable
UPDATE_HEALTH_CHECK_TIMEOUT_MS=60000
UPDATE_HEALTH_CHECK_INTERVAL_MS=2000
# How long update-agent waits for a Docker image pull to finish before giving up; raise on slow connections
UPDATE_PULL_TIMEOUT_MS=300000
# How often update-agent checks the manifest in the background (ms). Default is every 30 minutes; lower this for QA/testing (e.g. 300000 = 5 min).
STATUS_POLL_INTERVAL_MS=1800000
# Host path update-agent persists its own state to (currently: the last successfully applied manifest's createdAt, to reject replayed/downgraded manifests)
UPDATE_AGENT_STATE_DIR=./update-agent-state
# DEV ONLY — never set true in production. Simulates an update apply (goes through the same
# running/succeeded flow) without pulling or swapping any container, and never marks the
# manifest as applied — lets you exercise the Update page/waitroom repeatedly in dev, where an
# update is always "available" since local images never match the real signed manifest.
UPDATE_DRY_RUN=false
