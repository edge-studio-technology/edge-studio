# Local-only developer credentials. Copy to .env.local and fill in real values.
# .env.local is gitignored; this example file is not. Never commit real tokens.

# OpenProject (project manager) REST API v3 — used by scripts/dev/openproject.sh
# and the `openproject` agent skill. Nothing in the product runtime reads these.
#
# Base URL of the OpenProject instance, no trailing slash and no /api/v3 suffix.
OPEN_PROJECT_BASE_URL=https://openproject.example.com
# Personal API token: OpenProject > My Account > Access tokens > API.
# Sent as HTTP Basic auth with the literal username "apikey".
OPEN_PROJECT_ACCESS_TOKEN=
# Optional. Set to true to make the helper refuse every write (POST/PATCH).
OPEN_PROJECT_READONLY=false
